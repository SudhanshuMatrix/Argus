<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Every incoming SMS reaches SmsReceiver; READ_SMS is not needed -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Alerts: notifications, the full-screen red warning, vibration even on silent -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Setup asks to be left out of battery optimisation, or OEM savers kill the listener -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Optional "Display over other apps": lets the SCAM warning open over the app she is using.
         Without it the warning is full screen only on the lock screen (Android's full-screen intent). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional family SMS when a scam is flagged -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- SEND_SMS must not make the app require a phone radio -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- No INTERNET permission, ever: no message can leave the phone.
         Backup is off: nothing here is worth restoring and filesDir will hold the model copy.
         dataExtractionRules also blocks Android 12+ device-to-device transfer, which allowBackup doesn't. -->

    <application
        android:name=".ArgusApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Argus"
        tools:targetApi="33">

        <!-- Required by LiteRT-LM for the GPU backend; optional so phones without them still install -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share to check: long-press any text, Share, Argus -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Send reports for the family SMS (our own PendingIntents only) -->
        <receiver
            android:name=".alert.FamilySmsSentReceiver"
            android:exported="false" />

        <!-- The red warning. Shows over the lock screen (set in code, as minSdk 26 lacks the attributes).
             Own task, so "I understand" returns to whatever she was doing. -->
        <activity
            android:name=".alert.WarningActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.ajayinnovations.argus.warning" />

        <!-- WhatsApp messages, via their notifications -->
        <service
            android:name=".ingest.MessageListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SMS, even when the app is closed. BROADCAST_SMS: only the system can send this -->
        <receiver
            android:name=".ingest.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Lets AppCompat remember the in-app language on Android 12 and below -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
